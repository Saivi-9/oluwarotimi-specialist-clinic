{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "dev": "vinext dev",
    "build": "vinext build",
    "dev:cloudflare": "vite --config vite.cloudflare.config.ts",
    "build:cloudflare": "vite build --app --config vite.cloudflare.config.ts",
    "preview:cloudflare": "node scripts/cloudflare.mjs dev --local --config dist-cloudflare/server/wrangler.json",
    "check:cloudflare": "node scripts/cloudflare.mjs deploy --dry-run --config dist-cloudflare/server/wrangler.json",
    "test:cloudflare-preview": "node scripts/check-cloudflare-preview.mjs",
    "deploy:cloudflare": "node scripts/cloudflare.mjs deploy --config dist-cloudflare/server/wrangler.json",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^1.40.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
